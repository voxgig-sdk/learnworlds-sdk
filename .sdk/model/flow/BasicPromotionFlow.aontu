# BasicPromotionFlow

main: kit: flow: BasicPromotionFlow:
{
  entity: "promotion",
  kind: "basic",
  name: "BasicPromotionFlow",
  step: [
    {
      input: {
        ref: "promotion_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "promotion_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "promotion_ref01",
        srcdatavar: "promotion_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "promotion01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-promotion_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPromotionFlow"
}