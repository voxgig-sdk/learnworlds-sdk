# BasicUserGroupFlow

main: kit: flow: BasicUserGroupFlow:
{
  entity: "user_group",
  kind: "basic",
  name: "BasicUserGroupFlow",
  step: [
    {
      input: {
        ref: "user_group_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "user_group_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "user_group_ref01",
        srcdatavar: "user_group_ref01_data",
        suffix: "_up0",
        textfield: "assigned_segment_id"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-user_group_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "user_group_ref01",
        srcdatavar: "user_group_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "user_group01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-user_group_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicUserGroupFlow"
}