# BasicUserProgressFlow

main: kit: flow: BasicUserProgressFlow:
{
  entity: "user_progress",
  kind: "basic",
  name: "BasicUserProgressFlow",
  step: [
    {
      match: {
        course_id: "course01",
        user_id: "user01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "user_progress_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicUserProgressFlow"
}