# BasicBundleFlow

main: kit: flow: BasicBundleFlow:
{
  entity: "bundle",
  kind: "basic",
  name: "BasicBundleFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "bundle_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "bundle_ref01",
        srcdatavar: "bundle_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "bundle01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-bundle_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBundleFlow"
}