# BasicCertificateFlow

main: kit: flow: BasicCertificateFlow:
{
  entity: "certificate",
  kind: "basic",
  name: "BasicCertificateFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "certificate_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "certificate_ref01",
        srcdatavar: "certificate_ref01_data",
        suffix: "_up0",
        textfield: "course_id"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-certificate_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCertificateFlow"
}