# BasicCommunitySpaceFlow

main: kit: flow: BasicCommunitySpaceFlow:
{
  entity: "community_space",
  kind: "basic",
  name: "BasicCommunitySpaceFlow",
  step: [
    {
      input: {
        ref: "community_space_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "community_space_ref01",
        srcdatavar: "community_space_ref01_data",
        suffix: "_up0",
        textfield: "collectionId"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-community_space_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "community_space_ref01",
        srcdatavar: "community_space_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "community_space01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-community_space_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCommunitySpaceFlow"
}