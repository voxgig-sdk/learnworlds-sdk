  kind: "basic",
  name: "BasicCouponFlow",
  step: [
    {
      input: {
        ref: "coupon_ref01"
      }

      match: {
        promotion_id: "promotion01"
      }

      op: "create"
    }
  ],
  "key$": "BasicCouponFlow"
}