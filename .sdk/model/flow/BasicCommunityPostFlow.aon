# BasicCommunityPostFlow

main: kit: flow: BasicCommunityPostFlow:
{
  entity: "community_post",
  kind: "basic",
  name: "BasicCommunityPostFlow",
  step: [
    {
      input: {
        ref: "community_post_ref01",
        srcdatavar: "community_post_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "community_post01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-community_post_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCommunityPostFlow"
}