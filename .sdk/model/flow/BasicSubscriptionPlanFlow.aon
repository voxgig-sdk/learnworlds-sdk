# BasicSubscriptionPlanFlow

main: kit: flow: BasicSubscriptionPlanFlow:
{
  entity: "subscription_plan",
  kind: "basic",
  name: "BasicSubscriptionPlanFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "subscription_plan_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "subscription_plan_ref01",
        srcdatavar: "subscription_plan_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "subscription_plan01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-subscription_plan_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSubscriptionPlanFlow"
}