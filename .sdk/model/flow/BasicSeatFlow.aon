# BasicSeatFlow

main: kit: flow: BasicSeatFlow:
{
  entity: "seat",
  kind: "basic",
  name: "BasicSeatFlow",
  step: [
    {
      input: {
        ref: "seat_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "seat_ref01",
        srcdatavar: "seat_ref01_data",
        suffix: "_up0",
        textfield: "access"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-seat_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "seat_ref01",
        srcdatavar: "seat_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "seat01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-seat_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSeatFlow"
}