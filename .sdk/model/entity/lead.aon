    }
    {
      format: "float"
      name: "user_id"
      req: false
      short: "The unique identifier of the respective user"
      type: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    {
      format: "float"
      name: "user_registered_at"
      req: false
      short: "Date the respective lead was also registered as a user, in UNIX timestamp format"
      type: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "utms"
