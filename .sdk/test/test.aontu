# Tests are defined as sets of expected inputs and outputs
# The test runner script for each language loads the generated test.json
# file and runs the actual tests.

# Each language must pass these exact same tests, ensuring uniform
# behaviour over all languages.


# Tests for the core "struct" data structure utilities.
struct: minor: @"struct/minor.aontu"
struct: getpath: @"struct/getpath.aontu"
struct: inject: @"struct/inject.aontu"
struct: merge: @"struct/merge.aontu"
struct: transform: @"struct/transform.aontu"
struct: walk: @"struct/walk.aontu"
struct: validate: @"struct/validate.aontu"
struct: select: @"struct/select.aontu"


